{
  "name": "octura",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence OS for AI software delivery",
  "type": "module",
  "bin": {
    "octura-doctor": "./dist/octura-doctor.js",
    "octura-demo-seed": "./dist/octura-demo-seed.js",
    "octura-project-create": "./dist/octura-project-create.js",
    "octura-project-list": "./dist/octura-project-list.js",
    "octura-record-add": "./dist/octura-record-add.js",
    "octura-record-list": "./dist/octura-record-list.js",
    "octura-record-review": "./dist/octura-record-review.js",
    "octura-spec-kit-import": "./dist/octura-spec-kit-import.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "octura-doctor": "tsx src/octura-doctor.ts",
    "octura-demo-seed": "tsx src/octura-demo-seed.ts",
    "octura-project-create": "tsx src/octura-project-create.ts",
    "octura-project-list": "tsx src/octura-project-list.ts",
    "octura-record-add": "tsx src/octura-record-add.ts",
    "octura-record-list": "tsx src/octura-record-list.ts",
    "octura-record-review": "tsx src/octura-record-review.ts",
    "octura-spec-kit-import": "tsx src/octura-spec-kit-import.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.7.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "3.0.5"
  },
  "packageManager": "pnpm@9.15.0"
}
